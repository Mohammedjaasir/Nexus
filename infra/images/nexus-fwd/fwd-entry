#!/bin/sh
# fwd-entry: the Nexus-owned entry of the nexus-fwd image (B2a Task 12; fix round 1, item 9). POSIX sh (busybox ash).
#
# It runs exactly one program, socat, with the argv main wrote (`socat TCP-LISTEN:8080,fork,reuseaddr TCP:app:<port>`,
# planBuilder.ts), as positional parameters (never evaluated as shell text), under the dev deployment's lifetime
# (NEXUS_WALL_SECONDS: whole seconds, 1 to 604800), so the forwarder ends itself even when the runner is gone.
#
# Why socat is a CHILD of this shell, not exec'd: alpine's `timeout` is busybox's, which execs the program in place (as
# PID 1 here) and signals it from a helper; the kernel never delivers SIGKILL to a namespace's PID 1 from inside it, so
# `timeout -k` could not end a socat that ignores SIGTERM. Here this shell stays PID 1 and supervises:
#   - a watchdog child sends socat SIGTERM at the wall clock, then SIGKILL 10 s later (socat is not PID 1: KILL works);
#   - SIGTERM/SIGINT/SIGHUP to this shell (`docker stop`) is passed on to socat (PID 1 only acts on trapped signals);
#   - the shell exits with socat's status (143 after SIGTERM, 137 after SIGKILL).
# Verification (real Docker, the built image) must confirm: PID 1 is this shell and socat its child; a forwarder with
# NEXUS_WALL_SECONDS=2 exits by itself within 2 + 10 s even while a client holds a connection open; `docker stop` ends it
# within its grace; its exit code is 143 or 137.
die() { printf 'fwd-entry: %s\n' "$1" >&2; exit 64; }
[ "$1" = socat ] || die 'only socat runs in the forwarder'
case "${NEXUS_WALL_SECONDS:-}" in ''|*[!0-9]*) die 'NEXUS_WALL_SECONDS is not a whole number of seconds' ;; esac
[ "${#NEXUS_WALL_SECONDS}" -le 6 ] && [ "$NEXUS_WALL_SECONDS" -ge 1 ] && [ "$NEXUS_WALL_SECONDS" -le 604800 ] \
  || die 'NEXUS_WALL_SECONDS is out of range (1 to 604800)'

pass_on() { [ -n "${pid:-}" ] && kill -TERM "$pid" 2>/dev/null; }
trap pass_on TERM INT HUP

"$@" &
pid=$!
# The watchdog checks once a second that socat still runs (it leaves within a second of socat's end, holding nothing).
(
  i=0
  while [ "$i" -lt "$NEXUS_WALL_SECONDS" ]; do sleep 1; kill -0 "$pid" 2>/dev/null || exit 0; i=$((i + 1)); done
  kill -TERM "$pid" 2>/dev/null || exit 0
  i=0
  while [ "$i" -lt 10 ]; do sleep 1; kill -0 "$pid" 2>/dev/null || exit 0; i=$((i + 1)); done
  kill -KILL "$pid" 2>/dev/null
) </dev/null >/dev/null 2>&1 &
dog=$!

# `wait` returns early when a trapped signal arrives: wait again until socat itself has ended.
while :; do
  wait "$pid"
  rc=$?
  kill -0 "$pid" 2>/dev/null || break
done
kill "$dog" 2>/dev/null
exit "$rc"
