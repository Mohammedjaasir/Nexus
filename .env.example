DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=nexus-dev-secret
NEXUS_TOOL_ACTION_SIGNING_SECRET=nexus-dev-tool-action-signing-secret-change-me
NEXUS_SENTRY_RUN_FAILURES=off

# Optional Nexus ID Gmail OAuth broker. Enroll the instance first; keep both
# private keys in the deployment secret manager. HTTP base URLs must be loopback.
# NEXUS_ID_CONNECTOR_BASE_URL=http://localhost:3000
# NEXUS_ID_CONNECTOR_ENVIRONMENT=development
# NEXUS_ID_CONNECTOR_INSTANCE_ID=inst_example
# NEXUS_ID_CONNECTOR_SIGN_PRIVATE_KEY=
# NEXUS_ID_CONNECTOR_SEAL_PRIVATE_KEY=

# Process-wide protection for expensive full-tree workspace Git scans.
# NEXUS_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# NEXUS_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# NEXUS_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# NEXUS_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# HTTP adapters may call public HTTP(S) origins by default. Opt trusted private
# origins in explicitly; entries are exact origins (scheme, host, and port).
# NEXUS_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://hooks.internal.example:8080

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
